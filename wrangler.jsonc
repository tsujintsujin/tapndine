{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tapndine",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep the workers.dev address: justin94.space/tapndine proxies to it. Wrangler
  // turns it off when routes are set unless this says otherwise.
  "workers_dev": true,
  // tapndine's own domain. Cloudflare makes the DNS record and certificate.
  "routes": [{ "pattern": "tapndine.online", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tapndine",
      "database_id": "a8adbb9e-16c8-48ed-bae8-8e1a8af3f2ce",
      "migrations_dir": "migrations"
    }
  ]
}

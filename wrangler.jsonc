{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tapndine",
  // OpenNext's worker plus the daily plan-reminder job (custom-worker.ts).
  "main": "custom-worker.ts",
  // Every day at 9 AM Manila.
  "triggers": { "crons": ["0 1 * * *"] },
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker keeps its first name, tapndine: renaming it makes a new Worker without the secrets.
  "workers_dev": false,
  // tappetite's own domain. tapndine.online (the old name) only redirects to it,
  // in custom-worker.ts. Cloudflare makes the DNS records and certificates.
  "routes": [
    { "pattern": "tappetite.click", "custom_domain": true },
    { "pattern": "www.tappetite.click", "custom_domain": true },
    { "pattern": "tapndine.online", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tapndine",
      "database_id": "a8adbb9e-16c8-48ed-bae8-8e1a8af3f2ce",
      "migrations_dir": "migrations"
    }
  ]
}

{
  "name": "tapndine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300 -H 0.0.0.0",
    "build": "next build",
    "anim": "node videos/publish.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply tapndine --local --persist-to .localdb",
    "db:seed": "wrangler d1 execute tapndine --local --persist-to .localdb --file seed/dev.sql && wrangler d1 execute tapndine --local --persist-to .localdb --file seed/kusina.sql",
    "add-developer": "node scripts/add-developer.mjs",
    "db:reset": "rm -rf .localdb && npm run db:migrate && npm run db:seed",
    "db:seed-history": "node seed/history.mjs > .localdb/history.sql && wrangler d1 execute tapndine --local --persist-to .localdb --file .localdb/history.sql"
  },
  "dependencies": {
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "sharp@0.35.4": true,
    "sharp@0.35.5": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
